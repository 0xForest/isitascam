# Copy to .env. Docker loads it with --env-file .env.
WHATSAPP_BRIDGE=0
ALLOWED_HOSTS=localhost,127.0.0.1
# Optional exact browser origin when a proxy changes the scheme or host.
# Example: https://checker.example.com
PUBLIC_ORIGIN=

# Optional AI. Set both to enable it.
OPENROUTER_API_KEY=
OPENROUTER_MODEL=

# Default hostname checks. Set both to 0 for local wording checks only
# when all other providers and AI are off.
CLOUDFLARE_DNS_REPUTATION=1
SITE_AGE_CHECK=1
CTLOGS_API_KEY=

# Cloudflare URL Scanner. Set the account and token to read reports.
CLOUDFLARE_ACCOUNT_ID=
CLOUDFLARE_API_TOKEN=
CLOUDFLARE_SCAN_SCREENSHOTS=0
CLOUDFLARE_SUBMIT_SCANS=0
CLOUDFLARE_LIVE_SCREENSHOTS=0
# Radar defaults to the scanner token. An explicit empty value disables it.
# CLOUDFLARE_RADAR_API_TOKEN=

SPAMHAUS_DROP_ENABLED=0
URLHAUS_AUTH_KEY=
GOOGLE_SAFE_BROWSING_API_KEY=
VIRUSTOTAL_API_KEY=
VIRUSTOTAL_SUBMIT_SCANS=0
URLSCAN_API_KEY=
URLSCAN_SUBMIT_SCANS=0

# Optional WhatsApp allowlist of international numbers, comma-separated.
# An empty allowlist accepts direct messages from any number once paired.
WHATSAPP_TESTERS=

# Development-only diagnostics; model replies may contain submitted text.
LOG_AI_RESPONSES=0
